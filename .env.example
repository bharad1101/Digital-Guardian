# ==========================================================
# DIGITAL GUARDIAN - Environment configuration example
# ==========================================================
# Copy this file to ".env" and fill in real values. Never commit .env.
# Every value below is optional in development (sensible defaults are
# used) but SECRET_KEY is REQUIRED in production.

# --- Core -------------------------------------------------------------
# development | testing | production
FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-value

# --- Database ---------------------------------------------------------
# Defaults to SQLite at instance/digital_guardian.db.
# For PostgreSQL: postgresql+psycopg://user:pass@host:5432/digital_guardian
# DATABASE_URL=

# --- Sessions / cookies ----------------------------------------------
# Set SESSION_COOKIE_SECURE=true when served over HTTPS (forced in production).
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_SECONDS=43200

# --- CSRF -------------------------------------------------------------
WTF_CSRF_ENABLED=true

# --- Uploads ----------------------------------------------------------
MAX_CONTENT_LENGTH=8388608
MAX_IMAGE_DIMENSION=8000

# --- Rate limiting ----------------------------------------------------
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=300 per hour

# --- Analysis engine --------------------------------------------------
ML_MODEL_PATH=ml/spam_model.pkl
OCR_ENABLED=true
OCR_LANG=eng
OCR_MAX_CHARS=4000

# --- Privacy ----------------------------------------------------------
# 0 = keep scan history until the user deletes it.
DEFAULT_RETENTION_DAYS=0

# --- Optional: remote URL inspection (off by default) -----------------
# Only enable if you are comfortable making outbound requests to
# user-supplied URLs. The analyzer applies SSRF guards, but the safest
# default is disabled.
ENABLE_REMOTE_URL_INSPECTION=false
REMOTE_URL_TIMEOUT=5
REMOTE_URL_MAX_BYTES=524288
